{
  "$defs": {
    "ConstraintSpec": {
      "additionalProperties": false,
      "properties": {
        "safe_distance_m": {
          "minimum": 0,
          "title": "Safe Distance M",
          "type": "number"
        }
      },
      "required": [
        "safe_distance_m"
      ],
      "title": "ConstraintSpec",
      "type": "object"
    },
    "MissileSpec": {
      "additionalProperties": false,
      "properties": {
        "appearance_time_s": {
          "minimum": 0,
          "title": "Appearance Time S",
          "type": "number"
        },
        "guidance_model": {
          "enum": [
            "inertial_pure_pursuit",
            "instantaneous_pure_pursuit"
          ],
          "title": "Guidance Model",
          "type": "string"
        },
        "heading_response_rate_per_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Response Rate Per S"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "initial_position_at_appearance_body_m": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Position At Appearance Body M"
        },
        "initial_position_world_m": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Position World M"
        },
        "max_turn_rate_deg_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Turn Rate Deg S"
        },
        "optical_axis_model": {
          "const": "velocity_aligned",
          "title": "Optical Axis Model",
          "type": "string"
        },
        "speed_override_mps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed Override Mps"
        },
        "speed_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed Source"
        }
      },
      "required": [
        "id",
        "appearance_time_s",
        "guidance_model",
        "optical_axis_model"
      ],
      "title": "MissileSpec",
      "type": "object"
    },
    "ShipSpec": {
      "additionalProperties": false,
      "properties": {
        "heading_deg": {
          "title": "Heading Deg",
          "type": "number"
        },
        "initial_position_world_m": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Initial Position World M",
          "type": "array"
        }
      },
      "required": [
        "initial_position_world_m",
        "heading_deg"
      ],
      "title": "ShipSpec",
      "type": "object"
    },
    "UavSpec": {
      "additionalProperties": false,
      "properties": {
        "available_time_s": {
          "minimum": 0,
          "title": "Available Time S",
          "type": "number"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "available_time_s"
      ],
      "title": "UavSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumption_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Assumption Ids",
      "type": "array"
    },
    "constants_version": {
      "title": "Constants Version",
      "type": "string"
    },
    "constraints": {
      "$ref": "#/$defs/ConstraintSpec"
    },
    "missiles": {
      "items": {
        "$ref": "#/$defs/MissileSpec"
      },
      "minItems": 1,
      "title": "Missiles",
      "type": "array"
    },
    "model_layer": {
      "enum": [
        "formal",
        "ablation"
      ],
      "title": "Model Layer",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "ship": {
      "$ref": "#/$defs/ShipSpec"
    },
    "time_origin": {
      "const": "decision_start",
      "title": "Time Origin",
      "type": "string"
    },
    "uavs": {
      "items": {
        "$ref": "#/$defs/UavSpec"
      },
      "minItems": 1,
      "title": "Uavs",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "constants_version",
    "scenario_id",
    "time_origin",
    "model_layer",
    "assumption_ids",
    "ship",
    "uavs",
    "missiles",
    "constraints"
  ],
  "title": "Scenario",
  "type": "object"
}
